/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Firebase: berkas konfigurasi project (berisi API key + sender ID).
# Tidak di-commit karena repositori ini publik; setiap pengembang menaruh
# berkasnya sendiri dari Firebase Console.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Alat bantu screenshot/verifikasi di tool/ (bukan bagian aplikasi)
tool/node_modules/
tool/.chrome-profile/
